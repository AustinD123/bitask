# Copy this file to .env and fill in your keys. .env is git-ignored.
# Use either LLM_API_KEYS (comma-separated) or numbered GROQ_KEY_1, GROQ_KEY_2, ...
# Keys are tried in order (see README, "Groq setup").
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEYS=
LLM_MODEL=openai/gpt-oss-20b
